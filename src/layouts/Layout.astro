---
import "../styles/global.css";
import Nav from "../components/Nav.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Cassette · Native Subsonic and OpenSubsonic client for iOS and macOS",
  description = "A beautiful native iOS and macOS app for your self-hosted music. Built for Navidrome, Subsonic, OpenSubsonic. Open source, offline-first, no tracking.",
  noindex = false,
} = Astro.props;

const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(
  `${import.meta.env.BASE_URL}/og-card.png`.replace(/\/+/g, "/"),
  Astro.site,
).toString();

const siteUrl = Astro.site?.toString() ?? "https://getcassette.app/";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "Cassette",
      description,
      inLanguage: "en",
      publisher: { "@id": `${siteUrl}#person` },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}#app`,
      name: "Cassette",
      operatingSystem: "iOS 18.0+, macOS 15.0+",
      applicationCategory: "MusicApplication",
      applicationSubCategory: "Music Player",
      description,
      url: canonicalURL,
      downloadUrl: "https://testflight.apple.com/join/pxCpfpxF",
      screenshot: new URL(
        `${import.meta.env.BASE_URL}/images/header.png`.replace(/\/+/g, "/"),
        Astro.site,
      ).toString(),
      featureList: [
        "Native Swift and SwiftUI",
        "Offline playback with downloaded albums and playlists",
        "FLAC and lossless audio support",
        "Subsonic API compatible",
        "OpenSubsonic API compatible",
        "Navidrome, Airsonic, Gonic, Ampache support",
        "No tracking or telemetry",
        "Open source under MPL-2.0",
        "AirPlay support",
        "Lock screen and Now Playing controls",
        "Cover art with dominant color theming",
        "Queue management",
      ],
      keywords:
        "Navidrome client, Subsonic iOS app, OpenSubsonic client, self-hosted music player, Airsonic iOS, Gonic client, iPhone music player",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      },
      author: { "@id": `${siteUrl}#person` },
      license: "https://opensource.org/licenses/MPL-2.0",
      isAccessibleForFree: true,
      inLanguage: "en",
      softwareHelp: "https://github.com/CassetteLab/cassette",
      sameAs: ["https://github.com/CassetteLab/cassette"],
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}#person`,
      name: "Mathieu Dubart",
      url: "https://mathieu-dubart.fr",
      sameAs: [
        "https://github.com/MathieuDubart",
        "https://mathieu-dubart.fr",
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={isHome ? "#b8111e" : "#0b0b0c"} />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content={robotsContent} />
    <meta name="author" content="Mathieu Dubart" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="me" href="https://mastodon.social/@mathieudbrt"/>

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cassette" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cassette — Native iOS and macOS music player for Navidrome and Subsonic" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  </head>
  <body class="min-h-dvh bg-bg-primary text-text-primary antialiased">
    <Nav />
    <slot />

    <script>
      /* ── Scroll-triggered reveal ─────────────────────── */
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.06 }
      );

      const reveal = () => {
        document.querySelectorAll(".reveal:not(.is-visible)").forEach((el) => {
          observer.observe(el);
        });
      };

      reveal();
      document.addEventListener("astro:page-load", reveal);
    </script>
  </body>
</html>
