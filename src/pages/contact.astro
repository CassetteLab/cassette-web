---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import RollLabel from "../components/RollLabel.astro";

// Public by design: a Web3Forms access key only routes submissions to our
// inbox, it grants no other access.
const WEB3FORMS_KEY = "e86645e0-1536-4e91-85be-7c21b7adc73c";
const issuesUrl = "https://github.com/CassetteLab/cassette/issues";
---

<Layout
  title="Contact · Cassette"
  description="Questions, feedback or bug reports about Cassette. Every message is read."
>
  <main class="contact">
    <div class="shell contact-grid">
      <header class="contact-head">
        <p class="label">Contact</p>
        <h1 class="contact-title display">Say hi</h1>
        <p class="contact-lede">Questions, feedback, a server that won’t connect: every message is read.</p>

        <dl class="contact-alt">
          <div>
            <dt>Email</dt>
            <dd><a href="mailto:support@getcassette.app">support@getcassette.app</a></dd>
          </div>
          <div>
            <dt>Bugs and ideas</dt>
            <dd>
              <a href={issuesUrl} rel="noopener" target="_blank">GitHub issues ↗</a>
              <span class="contact-alt-note">easiest to track, and public</span>
            </dd>
          </div>
        </dl>
      </header>

      <div class="contact-body">
        <form id="contact-form" class="form" novalidate>
          <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
          <input type="hidden" name="from_name" value="Cassette website" />
          <!-- Honeypot: real people never see or fill this. -->
          <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" aria-hidden="true" />

          <div class="form-row">
            <div class="field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" autocomplete="name" placeholder="Optional" />
            </div>
            <div class="field">
              <label for="email">Email <span aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" required placeholder="So we can reply" />
            </div>
          </div>

          <div class="field">
            <label for="subject">Subject</label>
            <input id="subject" name="subject" type="text" placeholder="Optional" />
          </div>

          <div class="field">
            <label for="message">Message <span aria-hidden="true">*</span></label>
            <textarea id="message" name="message" rows="6" required placeholder="What’s on your mind?"></textarea>
          </div>

          <p id="form-error" class="form-error" aria-live="polite" hidden></p>

          <button type="submit" id="submit-btn" class="submit fx-roll">
            <span class="btn-text"><RollLabel text="Send message" arrow /></span>
            <span class="btn-sending" hidden>Sending…</span>
          </button>
        </form>

        <div id="form-success" class="success" hidden>
          <p class="success-title display">Sent</p>
          <p class="success-body">Thanks for writing. You’ll get an answer at the address you gave.</p>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .contact {
    padding: 7.5rem 0 6rem;
  }

  .contact-grid {
    display: grid;
    gap: 3.5rem;
  }

  .contact-title {
    margin: 1rem 0 0;
    font-size: clamp(5rem, 22vw, 12rem);
    color: color-mix(in oklab, var(--tint), white 15%);
  }

  .contact-lede {
    margin: 1.5rem 0 0;
    max-width: 26rem;
    font-size: 1.25rem;
    line-height: 1.45;
  }

  .contact-alt {
    margin: 2.5rem 0 0;
    max-width: 26rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .contact-alt div {
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .contact-alt dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
  }

  .contact-alt dd {
    margin: 0.35rem 0 0;
    font-size: 1.0625rem;
  }

  .contact-alt a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .contact-alt-note {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
  }

  /* ── Form ─────────────────────────────────────────────── */
  .form {
    display: grid;
    gap: 2rem;
  }

  .form-row {
    display: grid;
    gap: 2rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  .field label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.5rem 0 0.75rem;
    border: 0;
    border-bottom: 1px solid var(--color-border-subtle);
    border-radius: 0;
    background: transparent;
    color: var(--color-text-primary);
    font: inherit;
    font-size: 1.25rem;
    line-height: 1.4;
    transition: border-color 200ms ease;
  }

  .field textarea {
    resize: vertical;
    min-height: 9rem;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--color-text-tertiary);
  }

  .field input:hover,
  .field textarea:hover {
    border-bottom-color: var(--color-text-tertiary);
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: color-mix(in oklab, var(--tint), white 15%);
    box-shadow: 0 1px 0 color-mix(in oklab, var(--tint), white 15%);
  }

  .form-error {
    margin: 0;
    font-size: 0.9375rem;
    color: color-mix(in oklab, var(--tint), white 35%);
  }

  .submit {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 52px;
    padding: 0 1.5rem;
    border: 0;
    border-radius: 999px;
    background-color: var(--color-text-primary);
    color: var(--color-bg-primary);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .btn-text {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-text[hidden] {
    display: none;
  }

  /* ── Success ──────────────────────────────────────────── */
  .success-title {
    margin: 0;
    font-size: clamp(5rem, 18vw, 10rem);
    color: color-mix(in oklab, var(--tint), white 15%);
  }

  .success-body {
    margin: 1rem 0 0;
    max-width: 26rem;
    font-size: 1.25rem;
    line-height: 1.45;
  }

  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .contact {
      padding: 9rem 0 8rem;
    }

    .contact-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 5rem;
      align-items: start;
    }

    .contact-title {
      font-size: min(12vw, 12rem);
    }

    .contact-body {
      padding-top: 3.25rem;
    }
  }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const errorEl = document.getElementById("form-error");
  const successEl = document.getElementById("form-success");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
  const btnText = submitBtn?.querySelector<HTMLElement>(".btn-text");
  const btnSending = submitBtn?.querySelector<HTMLElement>(".btn-sending");

  // Swap labels instead of rewriting text, so the rolling label survives.
  const setSending = (on: boolean) => {
    if (submitBtn) submitBtn.disabled = on;
    if (btnText) btnText.hidden = on;
    if (btnSending) btnSending.hidden = !on;
  };

  const showError = (message: string) => {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.hidden = false;
  };

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
    const message = (form.elements.namedItem("message") as HTMLTextAreaElement).value.trim();
    if (!email || !message) {
      showError("Please fill in your email and a message.");
      return;
    }
    if (errorEl) errorEl.hidden = true;

    setSending(true);
    try {
      const data = new FormData(form);
      if (!data.get("subject")) data.set("subject", "Cassette: contact form");

      const res = await fetch("https://api.web3forms.com/submit", { method: "POST", body: data });
      const json = await res.json();
      if (!json.success) throw new Error(json.message ?? "Unknown error");

      form.hidden = true;
      if (successEl) successEl.hidden = false;
    } catch (err) {
      console.error("[contact form]", err);
      showError("That didn’t go through. You can email support@getcassette.app directly.");
      setSending(false);
    }
  });
</script>
