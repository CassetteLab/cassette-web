---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import RollLabel from "../components/RollLabel.astro";
---

<Layout
  title="Contact · Cassette"
  description="Get in touch with the Cassette team — questions, feedback, or bug reports."
>
  <main class="contact-main">
    <div class="contact-container">

      <!-- Header -->
      <div class="contact-header">
        <p class="section-label">
          <span class="label-dot"></span>
          Contact
        </p>
        <h1 class="contact-heading">Get in touch</h1>
        <p class="contact-subtitle">
          Questions, feedback, or bug reports, every message is read.
        </p>
      </div>

      <!-- Form -->
      <form id="contact-form" class="contact-form" novalidate>

        <!-- Web3Forms routing — replace the value with your access key -->
        <input type="hidden" name="access_key" value="e86645e0-1536-4e91-85be-7c21b7adc73c" />
        <input type="hidden" name="from_name" value="Cassette Website" />
        <!-- Prevents Web3Forms honeypot spam bots -->
        <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" aria-hidden="true" />

        <div class="field-row">
          <div class="field">
            <label class="field-label" for="name">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              class="field-input"
              placeholder="Your name"
              autocomplete="name"
            />
          </div>
          <div class="field">
            <label class="field-label" for="email">
              Email <span class="required" aria-hidden="true">*</span>
            </label>
            <input
              id="email"
              name="email"
              type="email"
              class="field-input"
              placeholder="you@example.com"
              autocomplete="email"
              required
            />
          </div>
        </div>

        <div class="field">
          <label class="field-label" for="subject">Subject</label>
          <input
            id="subject"
            name="subject"
            type="text"
            class="field-input"
            placeholder="What's this about?"
          />
        </div>

        <div class="field">
          <label class="field-label" for="message">
            Message <span class="required" aria-hidden="true">*</span>
          </label>
          <textarea
            id="message"
            name="message"
            class="field-input field-textarea"
            placeholder="Tell us what's on your mind…"
            rows="7"
            required
          ></textarea>
        </div>

        <!-- Inline feedback -->
        <p id="form-error" class="form-feedback form-error" aria-live="polite" hidden></p>

        <div class="form-footer">
          <p class="form-note">
            Or email directly:
            <a href="mailto:support@getcassette.app" class="form-email-link">
              support@getcassette.app
            </a>
          </p>
          <button type="submit" id="submit-btn" class="submit-btn fx-roll">
            <span class="btn-text"><RollLabel text="Send message" /></span>
            <span class="btn-sending" hidden>Sending…</span>
            <svg class="btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4"/>
            </svg>
          </button>
        </div>

      </form>

      <!-- Success state (shown after submission) -->
      <div id="form-success" class="form-success" hidden>
        <div class="success-icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 14l6 6L23 8"/>
          </svg>
        </div>
        <div>
          <p class="success-title">Message sent</p>
          <p class="success-body">Thanks for reaching out — we'll get back to you soon.</p>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ── Page layout ─────────────────────────────────────── */
  .contact-main {
    min-height: calc(100svh - 8rem);
    padding-top: 6rem;
    padding-bottom: 6rem;
  }

  .contact-container {
    max-width: 44rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  @media (min-width: 640px) {
    .contact-container { padding-inline: 2rem; }
  }

  /* ── Section label ───────────────────────────────────── */
  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
    margin: 0 0 1.25rem;
  }

  .label-dot {
    display: inline-block;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background-color: currentColor;
    flex-shrink: 0;
  }

  /* ── Header ──────────────────────────────────────────── */
  .contact-heading {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text-primary);
    margin: 0 0 1rem;
  }

  .contact-subtitle {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0 0 3rem;
  }

  /* ── Form ────────────────────────────────────────────── */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 560px) {
    .field-row { grid-template-columns: 1fr 1fr; }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .required {
    color: var(--color-accent-fg);
    margin-left: 0.125rem;
  }

  .field-input {
    width: 100%;
    background-color: rgba(35, 31, 53, 0.5);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    font-size: 0.9375rem;
    font-family: var(--font-sans);
    color: var(--color-text-primary);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    resize: none;
  }

  .field-input::placeholder {
    color: var(--color-text-tertiary);
  }

  .field-input:focus {
    outline: none;
    border-color: var(--color-accent-primary);
    box-shadow: 0 0 0 3px rgba(108, 71, 245, 0.15);
  }

  .field-textarea {
    resize: vertical;
    min-height: 10rem;
  }

  /* ── Feedback ────────────────────────────────────────── */
  .form-feedback {
    font-size: 0.875rem;
    margin: 0;
  }

  .form-error { color: #f87171; }

  /* ── Form footer ─────────────────────────────────────── */
  .form-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .form-note {
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
    margin: 0;
  }

  .form-email-link {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-decoration-color: var(--color-border-subtle);
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .form-email-link:hover {
    color: var(--color-text-primary);
  }

  /* ── Submit button ───────────────────────────────────── */
  .submit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    border: none;
    cursor: pointer;
    font-size: 0.9375rem;
    font-weight: 500;
    font-family: var(--font-sans);
    background-color: var(--color-accent-primary);
    color: #fff;
    transition: opacity 0.18s ease;
    white-space: nowrap;
  }


  .submit-btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  /* ── Success state ───────────────────────────────────── */
  .form-success {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.75rem;
    border-radius: 1rem;
    border: 1px solid rgba(108, 71, 245, 0.25);
    background-color: rgba(34, 30, 56, 0.5);
  }

  .success-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background-color: rgba(108, 71, 245, 0.15);
    color: var(--color-accent-fg);
  }

  .success-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0 0 0.25rem;
  }

  .success-body {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin: 0;
  }
</style>

<script>
  const form     = document.getElementById("contact-form") as HTMLFormElement | null;
  const errorEl  = document.getElementById("form-error");
  const successEl = document.getElementById("form-success");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
  const btnText  = submitBtn?.querySelector<HTMLElement>(".btn-text");
  const btnSending = submitBtn?.querySelector<HTMLElement>(".btn-sending");
  // Swap labels instead of rewriting text, so the rolling label survives.
  const setSending = (on: boolean) => {
    if (btnText) btnText.hidden = on;
    if (btnSending) btnSending.hidden = !on;
  };
  const btnArrow = submitBtn?.querySelector(".btn-arrow") as HTMLElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const email   = (document.getElementById("email")   as HTMLInputElement).value.trim();
    const message = (document.getElementById("message") as HTMLTextAreaElement).value.trim();

    // Client-side validation
    if (!email || !message) {
      if (errorEl) {
        errorEl.textContent = "Please fill in your email and message before sending.";
        errorEl.hidden = false;
      }
      return;
    }

    if (errorEl) errorEl.hidden = true;

    // Loading state
    if (submitBtn) submitBtn.disabled = true;
    setSending(true);
    if (btnArrow)  btnArrow.style.display = "none";

    try {
      const data = new FormData(form);
      // Ensure subject has a fallback
      if (!data.get("subject")) data.set("subject", "Cassette — contact form");

      const res  = await fetch("https://api.web3forms.com/submit", { method: "POST", body: data });
      const json = await res.json();

      if (json.success) {
        form.hidden = true;
        if (successEl) successEl.hidden = false;
      } else {
        throw new Error(json.message ?? "Unknown error");
      }
    } catch (err) {
      console.error("[contact form]", err);
      if (errorEl) {
        errorEl.textContent = "Something went wrong. Please email us directly at support@getcassette.app.";
        errorEl.hidden = false;
      }
      // Restore button
      if (submitBtn) submitBtn.disabled = false;
      setSending(false);
      if (btnArrow)  btnArrow.style.display = "";
    }
  });
</script>
