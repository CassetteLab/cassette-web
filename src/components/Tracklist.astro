---
const tracks = [
  {
    title: "Offline",
    body: "Download albums and playlists. Your library, search and queue keep working without a connection.",
  },
  {
    title: "Lossless",
    body: "FLAC and other lossless files play as they are, with a badge to show it. ReplayGain and crossfade too.",
  },
  {
    title: "Lyrics",
    body: "Synced lyrics, straight from your server when it has them.",
  },
  {
    title: "Rediscover",
    body: "Smart shuffle digs out the tracks you haven’t played in a while.",
  },
  {
    title: "Recap",
    body: "Your listening stats, worked out on your own device.",
  },
];

const servers = ["Navidrome", "Gonic", "Airsonic", "Ampache", "any OpenSubsonic server"];
---

<section id="tracklist" class="tracklist" aria-labelledby="tracklist-title">
  <div class="shell">
    <div class="tl-head" data-reveal="up">
      <h2 id="tracklist-title" class="label tl-title">Features</h2>
    </div>

    <ol class="tl-list">
      {
        tracks.map((t) => (
          <li class="tl-row" data-reveal-group data-reveal-start="top 88%">
            <h3 class="tl-name display" data-reveal="chars" data-reveal-stagger="0.025">{t.title}</h3>
            <p class="tl-body" data-reveal="up" data-reveal-delay="0.15">{t.body}</p>
          </li>
        ))
      }
    </ol>

    <p class="tl-servers" data-reveal="up">
      <span class="label">Works with</span>
      <span class="tl-server-list">
        {servers.map((s) => <span>{s}</span>)}
      </span>
    </p>
  </div>
</section>

<style>
  .tracklist {
    padding-block: 2rem 6rem;
  }

  .tl-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .tl-title {
    margin: 0;
  }

  .tl-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tl-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: baseline;
    column-gap: 0.5rem;
    padding: 1.25rem 0 1.5rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  /* Hover: the row takes the current color, full bleed. */
  .tl-row::before {
    content: "";
    position: absolute;
    inset: -1px -100vmax;
    z-index: -1;
    background-color: var(--tint);
    opacity: 0;
    transition: opacity 250ms ease;
  }

  .tl-row:hover {
    color: var(--ink);
  }

  .tl-row:hover::before {
    opacity: 1;
  }

  .tl-row:hover .tl-body {
    color: inherit;
  }

  .tl-name {
    margin: 0;
    font-size: clamp(3.5rem, 15vw, 11rem);
  }

  .tl-body {
    margin: 0.75rem 0 0;
    max-width: 26rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    transition: color 250ms ease;
  }

  .tl-servers {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin: 2rem 0 0;
  }

  .tl-server-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .tl-server-list span + span::before {
    content: "/";
    margin-right: 1.25rem;
    color: var(--color-text-tertiary);
  }

  @media (min-width: 900px) {
    .tracklist {
      padding-block: 3rem 9rem;
    }

    .tl-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
      align-items: center;
      padding: 0.75rem 0;
    }

    .tl-name {
      font-size: min(10.5vw, 11rem);
      padding-top: 0.08em;
    }

    .tl-body {
      margin: 0;
    }
  }

  .tracklist {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
  }
</style>
