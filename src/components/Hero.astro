---
import { Image } from "astro:assets";
import { heroScreens } from "../data/screens";
import NowPlaying from "./NowPlaying.astro";
import Button from "./Button.astro";

const testflightUrl = "https://testflight.apple.com/join/pxCpfpxF";
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero-stage shell">
    <h1 id="hero-title" class="hero-word display">
      <span aria-hidden="true" data-hero-word data-intro>Cassette</span>
      <span class="sr-only">
        Cassette, a native iOS and macOS music player for Navidrome, Subsonic and OpenSubsonic servers
      </span>
    </h1>

    <div class="hero-phone" data-hero-phone>
      <div class="phone-parallax" data-phone-parallax>
      <div class="phone-motion" data-phone-motion data-intro>
      {
        heroScreens.map((s, i) => (
          <Image
            src={s.img}
            alt={s.alt}
            widths={[320, 480, 720, 960]}
            sizes="(min-width: 768px) 44vh, 64vw"
            class:list={["phone-img", { "is-active": i === 0 }]}
            loading="eager"
            fetchpriority={i === 0 ? "high" : "auto"}
            decoding={i === 0 ? "sync" : "async"}
            data-screen={i}
            aria-hidden={i === 0 ? undefined : "true"}
          />
        ))
      }
      </div>
      </div>
    </div>

    <div class="hero-intro" data-intro>
      <NowPlaying />
      <p class="hero-lede" data-hero-lede>
        A native iPhone and Mac app for the music on your own server.
      </p>
      <p class="hero-sub" data-hero-step>
        Built for Navidrome, and for anything else that speaks Subsonic. Free and open source.
      </p>

      <div class="hero-cta">
        <Button href={testflightUrl} label="Join the beta" arrow data-hero-step />
        <Button href="#install" label="Get it on Mac" variant="line" data-hero-step />
      </div>
    </div>

    <div class="hero-deck" data-hero-deck data-intro>
      <p class="deck-label" data-hero-deck-step>In the app</p>
      <ol class="deck-list">
        {
          heroScreens.map((s, i) => (
            <li data-hero-deck-step>
              <button
                type="button"
                class="deck-item"
                data-screen-btn={i}
                data-tint={s.tint}
                data-ink={s.ink}
                aria-pressed={i === 0 ? "true" : "false"}
              >
                <span class="deck-num">{String(i + 1).padStart(2, "0")}</span>
                <span class="deck-text">
                  <span class="deck-title">{s.title}</span>
                  <span class="deck-by">{s.by}</span>
                </span>
                <span class="deck-bar" aria-hidden="true"><span /></span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background-color: var(--tint);
    color: var(--ink);
    overflow: clip;
  }

  .hero-stage {
    max-width: none;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    padding-top: 5.5rem;
    padding-bottom: 2.5rem;
    row-gap: 2rem;
  }

  /* ── The word ─────────────────────────────────────────── */
  .hero-word {
    margin: 0;
    width: 100%;
    font-size: 26.6vw;
    text-align: center;
    line-height: 0.8;
    z-index: 0;
    user-select: none;
    /* Decorative giant type: its text box is far taller than the visible
       letters (tight line-height, big font ascent), so it must never take
       clicks meant for the links around it. */
    pointer-events: none;
  }

  /* With the 3D phone (desktop), the 2D one is out (it's absolutely
     positioned there, so nothing reflows). */
  :global(html[data-3d]) .hero-phone {
    display: none;
  }

  /* Inline-block so GSAP's scroll parallax can transform it. */
  [data-hero-word] {
    display: inline-block;
  }

  /* ── The phone ────────────────────────────────────────── */
  .hero-phone {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(64vw, 22rem);
    margin-top: -16vw;
    aspect-ratio: 1510 / 3040;
    filter: drop-shadow(0 40px 50px rgb(0 0 0 / 0.32));
  }

  /* Two wrappers so GSAP never touches the positioning transform on
     .hero-phone (desktop centering), and so the scroll parallax and the
     intro never animate the same element. */
  .phone-parallax,
  .phone-motion {
    display: grid;
    width: 100%;
    height: 100%;
  }

  /*
   * Screen changes are a wipe, never a crossfade: the incoming screenshot is
   * revealed from the bottom up on top of the outgoing one. Every screenshot
   * shares the same phone frame, so only the screen appears to change.
   */
  .phone-img {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    visibility: hidden;
    z-index: 0;
  }

  .phone-img.is-active,
  .phone-img.is-leaving {
    visibility: visible;
  }

  .phone-img.is-leaving {
    z-index: 1;
  }

  .phone-img.is-active {
    z-index: 2;
  }

  .phone-img.is-entering {
    animation: screen-in 820ms cubic-bezier(0.76, 0, 0.18, 1) both;
  }

  @keyframes screen-in {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* ── Intro + CTAs ─────────────────────────────────────── */
  .hero-intro {
    width: 100%;
    max-width: 30rem;
    justify-self: start;
  }

  .hero-lede {
    margin: 0;
    font-size: 1.625rem;
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .hero-sub {
    margin: 0.75rem 0 0;
    font-size: 1rem;
    line-height: 1.5;
    opacity: 0.8;
    max-width: 26rem;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.5rem;
  }

  /* ── Deck (which screen is showing) ───────────────────── */
  .hero-deck {
    width: 100%;
    justify-self: start;
  }

  .deck-label {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .deck-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem 1rem;
  }

  .deck-item {
    all: unset;
    box-sizing: border-box;
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.625rem;
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0 0.75rem;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.35;
    opacity: 0.55;
    transition: opacity 200ms ease;
  }

  .deck-item:hover,
  .deck-item[aria-pressed="true"] {
    opacity: 1;
  }

  .deck-item:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .deck-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .deck-title {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .deck-by {
    opacity: 0.75;
  }

  .deck-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.25rem;
    height: 2px;
    background: color-mix(in srgb, currentColor 22%, transparent);
    overflow: hidden;
  }

  .deck-bar span {
    display: block;
    height: 100%;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
  }

  .deck-item[aria-pressed="true"] .deck-bar span {
    transform: scaleX(1);
  }

  /* While auto-playing, the active bar fills over the dwell time. */
  .hero[data-playing] .deck-item[aria-pressed="true"] .deck-bar span {
    animation: deck-fill var(--dwell, 5200ms) linear both;
  }

  .hero[data-paused] .deck-item[aria-pressed="true"] .deck-bar span {
    animation-play-state: paused;
  }

  @keyframes deck-fill {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  /* ── Desktop: the poster layout ───────────────────────── */
  @media (min-width: 900px) and (min-height: 640px) {
    .hero-stage {
      display: block;
      height: 100svh;
      min-height: 46rem;
      max-height: 68rem;
      padding: 0;
    }

    .hero-word {
      position: absolute;
      left: 0;
      right: 0;
      top: 6.25rem;
      font-size: min(28.4vw, 52svh);
    }

    .hero-phone {
      position: absolute;
      left: 50%;
      bottom: 0;
      width: auto;
      height: calc(100% - 5.5rem);
      margin: 0;
      transform: translate(-50%, 9%);
    }

    .hero-intro {
      position: absolute;
      left: 2.5rem;
      bottom: 2.5rem;
      width: calc(50% - 15rem);
      max-width: 26rem;
    }

    .hero-lede {
      font-size: clamp(1.5rem, 2.1vw, 2rem);
    }

    .hero-deck {
      position: absolute;
      right: 2.5rem;
      bottom: 2.5rem;
      width: calc(50% - 15rem);
      max-width: 19rem;
    }

    .deck-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phone-img.is-entering {
      animation: none;
    }
  }
</style>

<script>
  import { initHero } from "../scripts/hero";

  initHero();
  document.addEventListener("astro:page-load", initHero);
</script>
