---
// Figures are rounded and hardcoded on purpose. Update them by hand.
const stats = [
  { value: "1,300+", caption: "people in the public TestFlight beta" },
  { value: "150+", caption: "stars on GitHub" },
  { value: "0", caption: "trackers or analytics in the app" },
];

// Real messages from testers. Anonymous, quoted as received.
const quotes = [
  "I’ve tested 5–6 Navidrome apps. Yours is the absolute best one.",
  "This is now going to be my daily driver.",
  "It feels native to iOS and is beautifully done.",
];
---

<section class="proof" aria-labelledby="proof-title">
  <div class="shell">
    <h2 id="proof-title" class="label" data-reveal="up">Testers</h2>

    <dl class="stats">
      {
        stats.map((s, i) => (
          <div class="stat" data-reveal-group data-reveal="up" data-reveal-delay={i * 0.08}>
            <dt class="stat-caption">{s.caption}</dt>
            <dd class="stat-value display" data-reveal="count" data-reveal-delay={i * 0.08}>{s.value}</dd>
          </div>
        ))
      }
    </dl>

    <p class="proof-note" data-reveal="up">
      An Android port is on the way, written by a contributor. The app is funded by the people who use it, <a href="https://ko-fi.com/mathieudbrt" rel="noopener" target="_blank">on Ko-fi</a>.
    </p>

    <ul class="quotes">
      {
        quotes.map((q) => (
          <li class="quote" data-reveal-group>
            <blockquote>
              <p data-reveal="lines">“{q.replace(/^“|”$/g, "")}”</p>
            </blockquote>
            <p class="quote-by" data-reveal="up" data-reveal-delay="0.35">TestFlight tester</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .proof {
    padding-block: 6rem 7rem;
  }

  .stats {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 1.5rem 0 0;
    border-top: 1px solid var(--color-border-subtle);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 1.5rem 0 2rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .stat-value {
    margin: 0;
    font-size: clamp(5.5rem, 22vw, 15rem);
    /* The tint, lifted a bit so it holds up on the dark ground. */
    color: color-mix(in oklab, var(--tint), white 22%);
  }

  .stat-caption {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    max-width: 18rem;
  }

  .proof-note {
    margin: 2rem 0 0;
    max-width: 34rem;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .proof-note a {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .quotes {
    list-style: none;
    margin: 5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }

  .quote blockquote {
    margin: 0;
  }

  .quote blockquote p {
    margin: 0;
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .quote-by {
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
  }

  @media (min-width: 900px) {
    .proof {
      padding-block: 9rem 10rem;
    }

    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .stat {
      padding: 1.5rem 1.5rem 2.5rem 0;
      border-bottom: 0;
    }

    .stat + .stat {
      padding-left: 1.5rem;
      border-left: 1px solid var(--color-border-subtle);
    }

    .stat-value {
      font-size: min(10.5vw, 13rem);
    }

    .quotes {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      margin-top: 8rem;
      row-gap: 5rem;
    }

    .quote:nth-child(1) {
      grid-column: 1 / span 7;
    }

    .quote:nth-child(2) {
      grid-column: 8 / span 5;
      padding-top: 8rem;
    }

    .quote:nth-child(3) {
      grid-column: 3 / span 6;
    }
  }
</style>
