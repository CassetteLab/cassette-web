---
// Answers are drawn from existing, verified site copy — no new claims.
// The visible text and the FAQPage schema below are kept identical so the
// structured data always matches what's on the page (Google requirement).
const faqs = [
  {
    q: "What is Cassette?",
    a: "Cassette is a native iOS and macOS music client for Subsonic and OpenSubsonic servers. It lets you stream and download your self-hosted music library on iPhone and Mac, with a fast, beautiful interface built entirely in Swift and SwiftUI.",
  },
  {
    q: "Which servers does Cassette work with?",
    a: "Cassette connects to any Subsonic-compatible or OpenSubsonic-compatible server. You bring your own server and keep full ownership of your library, your files, and your data.",
  },
  {
    q: "Is Cassette free and open source?",
    a: "Yes. Cassette is open source under the MPL-2.0 license — there are no accounts to create, no ads, and no tracking or telemetry.",
  },
  {
    q: "Can I listen to my music offline?",
    a: "Yes. You can download albums and playlists for true offline playback. Your library, search, queue, and favorites keep working even when there is no connection.",
  },
  {
    q: "How do I install Cassette on iPhone or Mac?",
    a: "On iPhone, join the TestFlight beta. On macOS, install it with Homebrew: brew tap CassetteLab/cassette, then brew install --cask cassette.",
  },
  {
    q: "What audio formats does Cassette support?",
    a: "Cassette supports FLAC and lossless audio, with badges so you always know what you are hearing, plus AirPlay and full lock screen and Now Playing controls.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="faq-inner shell">
    <div class="faq-head">
      <p class="label reveal">liner notes</p>
      <h2 id="faq-title" class="faq-title display reveal">Questions</h2>
    </div>

    <div class="faq-list">
      {
        faqs.map((f, i) => (
          <details class="faq-item reveal" style={`--delay: ${i * 50}ms`}>
            <summary class="faq-q">
              <h3 class="faq-q-text">{f.q}</h3>
              <span class="faq-icon" aria-hidden="true">
                <svg viewBox="0 0 16 16"><path d="M8 3v10M3 8h10" /></svg>
              </span>
            </summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script
  type="application/ld+json"
  set:html={JSON.stringify(faqJsonLd)}
  is:inline
/>

<style>
  .faq {
    padding-block: 6rem;
  }

  .faq-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  .faq-title {
    margin: 0.5rem 0 0;
    font-size: clamp(4rem, 15vw, 9rem);
  }

  .faq-list {
    border-top: 1px solid var(--color-border-subtle);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 44px;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-q-text {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .faq-icon {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    transition: transform 250ms var(--ease-out-expo);
  }

  .faq-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-a {
    margin: 0;
    padding: 0 0 1.5rem;
    max-width: 40rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  @media (min-width: 900px) {
    .faq {
      padding-block: 9rem;
    }

    .faq-inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 3rem;
      align-items: start;
    }

    .faq-head {
      position: sticky;
      top: 6rem;
    }
  }
</style>
