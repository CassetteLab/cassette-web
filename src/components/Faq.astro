---
// Answers are drawn from existing, verified site copy — no new claims.
// The visible text and the FAQPage schema below are kept identical so the
// structured data always matches what's on the page (Google requirement).
const faqs = [
  {
    q: "What is Cassette?",
    a: "A native iPhone and Mac app for listening to the music on your own Subsonic or OpenSubsonic server, such as Navidrome. You can stream your library or download it for offline listening.",
  },
  {
    q: "Which servers does Cassette work with?",
    a: "Any server that implements the Subsonic or OpenSubsonic API: Navidrome, Gonic, Airsonic, Ampache and others. Your music stays on your server.",
  },
  {
    q: "Is Cassette free and open source?",
    a: "Yes. It is free, and the source code is published under the MPL-2.0 license. There is no account, no advertising and no analytics.",
  },
  {
    q: "Can I listen to my music offline?",
    a: "Yes. Download albums and playlists, and your library, search and queue keep working without a connection.",
  },
  {
    q: "How do I install Cassette on iPhone or Mac?",
    a: "On iPhone, download it for free from the App Store. On Mac, install it with Homebrew: brew tap CassetteLab/cassette, then brew install --cask cassette.",
  },
  {
    q: "What audio formats does Cassette support?",
    a: "FLAC and other lossless formats, marked with a badge in the player, as well as the usual lossy formats. AirPlay, lock screen and Now Playing controls are supported.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="faq-inner shell">
    <div class="faq-head" data-reveal-group>
      <p class="label" data-reveal="up">FAQ</p>
      <h2 id="faq-title" class="faq-title display" data-reveal="up">Questions</h2>
    </div>

    <div class="faq-list" data-reveal-group>
      {
        faqs.map((f) => (
          <details class="faq-item" data-reveal="up">
            <summary class="faq-q">
              <h3 class="faq-q-text">{f.q}</h3>
              <span class="faq-icon" aria-hidden="true">
                <svg viewBox="0 0 16 16"><path d="M8 3v10M3 8h10" /></svg>
              </span>
            </summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script
  type="application/ld+json"
  set:html={JSON.stringify(faqJsonLd)}
  is:inline
/>

<style>
  .faq {
    padding-block: 6rem;
  }

  .faq-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  .faq-title {
    margin: 0.5rem 0 0;
    font-size: clamp(4rem, 15vw, 9rem);
  }

  .faq-list {
    border-top: 1px solid var(--color-border-subtle);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 44px;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-q-text {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .faq-icon {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    transition: transform 250ms var(--ease-out-expo);
  }

  .faq-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-a {
    margin: 0;
    padding: 0 0 1.5rem;
    max-width: 40rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  @media (min-width: 900px) {
    .faq {
      padding-block: 9rem;
    }

    .faq-inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 3rem;
      align-items: start;
    }

    .faq-head {
      position: sticky;
      top: 6rem;
    }
  }
</style>
