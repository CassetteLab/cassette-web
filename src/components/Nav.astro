---
const githubUrl = "https://github.com/CassetteLab/cassette";
const logoUrl = `${import.meta.env.BASE_URL}/images/cassette-icon-1024.png`.replace(/\/+/g, "/");
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
---

<header id="site-nav" class="site-nav" data-on-hero={isHome ? "" : undefined}>
  <div class="nav-inner shell" style="max-width: none">
    <a href="/" class="nav-logo" aria-label="Cassette home">
      <img src={logoUrl} alt="" width="28" height="28" loading="eager" decoding="sync" />
      <span>Cassette</span>
    </a>

    <nav aria-label="Primary">
      <a href="/#tracklist" class="nav-link hide-sm">Features</a>
      <a href="/#install" class="nav-link">Install</a>
      <a href="/#faq" class="nav-link hide-sm">FAQ</a>
      <a href={githubUrl} rel="noopener" target="_blank" class="nav-link">GitHub ↗</a>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--color-text-primary);
    background-color: rgb(11 11 12 / 0.86);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-bottom: 1px solid var(--color-border-subtle);
    transition:
      background-color 300ms ease,
      border-color 300ms ease,
      color 300ms ease;
  }

  /* Over the hero: no bar, takes the screen's ink color. */
  .site-nav[data-on-hero] {
    color: var(--ink);
    background-color: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .nav-logo img {
    width: 28px;
    height: 28px;
    border-radius: 7px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 150ms ease;
  }

  .nav-link:hover {
    opacity: 1;
  }

  @media (max-width: 639px) {
    .hide-sm {
      display: none;
    }
  }
</style>

<script>
  const initNav = () => {
    const nav = document.getElementById("site-nav");
    const hero = document.querySelector("[data-hero]");
    if (!nav || !hero) return;

    new IntersectionObserver(
      ([entry]) => nav.toggleAttribute("data-on-hero", entry.isIntersecting),
      { rootMargin: "-64px 0px 0px 0px", threshold: 0 },
    ).observe(hero);
  };

  initNav();
  document.addEventListener("astro:page-load", initNav);
</script>
