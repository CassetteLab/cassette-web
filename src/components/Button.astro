---
/*
 * Pill link-button for tinted stages (hero, install block, 404): colors come
 * from --ink / --tint, so it always contrasts with the screen of the moment.
 *
 *  solid  filled with --ink; on hover the label rolls letter by letter (.fx-roll)
 *  line   outlined in --ink; on hover it fills from the pointer (.fx-fill)
 *
 * The hover effects and the magnetic pull live in global.css / motion.ts.
 */
import type { HTMLAttributes } from "astro/types";
import RollLabel from "./RollLabel.astro";

interface Props extends Omit<HTMLAttributes<"a">, "href"> {
  href: string;
  label: string;
  variant?: "solid" | "line";
  /** Show the diagonal arrow (solid only). */
  arrow?: boolean;
  /** Opens in a new tab with rel=noopener. Defaults to true for http(s) links. */
  external?: boolean;
  size?: "md" | "lg";
}

// Anything else (data-*, aria-*…) goes straight onto the <a>.
const { href, label, variant = "solid", arrow = false, size = "md", external: ext, ...attrs } = Astro.props;
const external = ext ?? /^https?:\/\//.test(href);
const linkAttrs = external ? { rel: "noopener", target: "_blank" } : {};
---

{
  variant === "solid" ? (
    <a class:list={["btn", "btn-solid", "fx-roll", `btn-${size}`]} href={href} {...linkAttrs} {...attrs}>
      <RollLabel text={label} arrow={arrow} />
    </a>
  ) : (
    <a class:list={["btn", "btn-line", "fx-fill", `btn-${size}`]} href={href} {...linkAttrs} {...attrs}>
      {label}
    </a>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .btn-md {
    min-height: 48px;
    padding: 0 1.25rem;
    font-size: 0.9375rem;
  }

  .btn-lg {
    min-height: 52px;
    padding: 0 1.5rem;
    font-size: 1rem;
  }

  .btn-solid {
    background-color: var(--ink);
    color: var(--tint);
  }

  .btn-line {
    box-shadow: inset 0 0 0 1.5px var(--ink);
    color: var(--ink);
    --fill: var(--ink);
    --fill-ink: var(--tint);
  }
</style>
