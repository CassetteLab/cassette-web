---
/*
 * Mac section. Desktop: the section pins, the copy stays on the left and the
 * Mac screenshots travel right-to-left as you scroll (src/scripts/motion.ts).
 * Phones and reduced motion: the copy, then the screenshots stacked.
 */
import { Image } from "astro:assets";
import library from "../assets/screens/mac-library.png";
import player from "../assets/screens/mac-player.png";
import album from "../assets/screens/mac-album.png";
import wrapped from "../assets/screens/mac-wrapped.png";

const shots = [
  { img: library, caption: "Library", alt: "Cassette's library on Mac: recently added and recently played albums in a grid, sidebar on the left." },
  { img: player, caption: "Lyrics", alt: "Cassette's full-screen player on Mac, with synced lyrics next to the cover." },
  { img: album, caption: "Albums", alt: "An album page in Cassette on Mac, with the sidebar and the mini player." },
  { img: wrapped, caption: "Recap", alt: "Cassette's listening recap on Mac: minutes listened and top artists." },
];

const facts: [string, string][] = [
  ["⌘F", "search from anywhere"],
  ["⌥← ⌥→", "jump back or ahead 10 s"],
  ["Notarized", "signed by Apple, outside the Mac App Store"],
  ["Homebrew", "installed and updated as a cask"],
];
---

<section id="mac" class="mac" aria-labelledby="mac-title" data-mac>
  <div class="mac-stage" data-mac-stage>
    <div class="mac-copy">
      <p class="label">Mac</p>
      <h2 id="mac-title" class="mac-title display">
        <span class="mac-line">Also on</span>
        <span class="mac-line">Mac</span>
      </h2>
      <p class="mac-body">
        The same Swift codebase as the iPhone app, laid out for a desktop, with a sidebar and the keyboard shortcuts you would expect.
      </p>
      <dl class="mac-facts">
        {
          facts.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
      <a class="mac-install" href="#install">brew install --cask cassette <span aria-hidden="true">↓</span></a>
    </div>

    <div class="mac-window" data-mac-window>
      <ul class="mac-track" data-mac-track>
        {
          shots.map((s, i) => (
            <li class="mac-shot">
              <Image
                src={s.img}
                alt={s.alt}
                widths={[640, 960, 1440]}
                sizes="(min-width: 900px) 56vw, 100vw"
                loading={i === 0 ? "eager" : "lazy"}
              />
              <p class="mac-caption">
                <span>{String(i + 1).padStart(2, "0")}</span> {s.caption}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .mac {
    padding-block: 4rem 6rem;
    border-top: 1px solid var(--color-border-subtle);
    overflow: clip;
  }

  .mac-stage {
    display: grid;
    gap: 3rem;
    width: 100%;
    max-width: 96rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .mac-line {
    display: block;
    white-space: nowrap;
  }

  .mac-title {
    margin: 0.5rem 0 0;
    font-size: clamp(4rem, 17vw, 9rem);
  }

  .mac-body {
    margin: 1.5rem 0 0;
    max-width: 28rem;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .mac-facts {
    display: grid;
    margin: 2rem 0 0;
    max-width: 28rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .mac-facts div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .mac-facts dt {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: color-mix(in oklab, var(--tint), white 25%);
  }

  .mac-facts dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }

  .mac-install {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .mac-track {
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mac-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .mac-caption {
    margin: 0.75rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
  }

  .mac-caption span {
    color: var(--color-text-secondary);
  }

  /* Desktop: copy on the left, a window on the right the track slides through. */
  @media (min-width: 900px) {
    .mac {
      padding-block: 0;
    }

    .mac-stage {
      grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
      align-items: center;
      gap: 4rem;
      min-height: 100svh;
      max-width: none;
      padding-inline: 2.5rem 0;
    }

    .mac-title {
      font-size: min(9vw, 9rem);
    }

    .mac-window {
      overflow: hidden;
      padding-block: 2rem;
    }

    .mac-track {
      display: flex;
      gap: 3rem;
      width: max-content;
      padding-right: 2.5rem;
    }

    .mac-shot {
      flex: none;
      width: min(56vw, 64rem);
    }
  }
</style>
